[Unit]
Description=VNC server exposing the traffic-portal sign-in display on loopback
After=portal-console-xvfb@%i.service
Requires=portal-console-xvfb@%i.service

[Service]
Type=simple
User=%i
Environment=DISPLAY=:99
# -localhost is the security boundary, not a convenience: it binds 5900 to
# 127.0.0.1 so the only way in is the authenticated nginx proxy. Never remove
# it to "test from outside" - an unauthenticated VNC port on a public address
# is a keyboard on a signed-in government portal.
# -rfbauth: a second password, independent of nginx's. Generated by install.sh
# with x11vnc -storepasswd; it is not in this repository and must not be.
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5900 \
	-rfbauth /etc/portal-console/vncpasswd \
	-forever -shared -noxdamage -repeat -nopw_warning
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
